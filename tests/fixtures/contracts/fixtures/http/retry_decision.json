        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false,
        "code": "authentication_failed"
      }
    },
    {
      "name": "get_403_never",
      "input": {
        "method": "GET",
        "outcome": "status:403",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false,
        "code": "forbidden"
      }
    },
    {
      "name": "get_404_never",
      "input": {
        "method": "GET",
        "outcome": "status:404",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false
      }
    },
    {
      "name": "get_tls_failure_never",
      "input": {
        "method": "GET",
        "outcome": "tls_failure",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false
      }
    },
    {
      "name": "get_unmapped_5xx_retries",
      "input": {
        "method": "GET",
        "outcome": "status:599",
