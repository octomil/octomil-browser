        "operation": "planner"
      },
      "expect": {
        "retry": true
      }
    },
    {
      "name": "attempts_exhausted_planner",
      "input": {
        "method": "GET",
        "outcome": "status:503",
        "attempt": 2,
        "operation": "planner"
      },
      "expect": {
        "retry": false
      }
    },
    {
      "name": "attempts_exhausted_heartbeat",
      "input": {
        "method": "GET",
        "outcome": "status:503",
        "attempt": 1,
        "operation": "heartbeat"
      },
      "expect": {
        "retry": false
      }
    },
    {
      "name": "download_retries_up_to_5",
      "input": {
        "method": "GET",
        "outcome": "status:503",
        "attempt": 3,
        "operation": "download"
      },
      "expect": {
        "retry": true,
        "delay_max_ms": 4000
      }
    }
  ]
}
