{
  "kind": "http_decide",
  "description": "Retry decisions. Ambiguous outcomes retry only on idempotent methods; auth errors never retry.",
  "cases": [
    {
      "name": "get_503_retries",
      "input": {
        "method": "GET",
        "outcome": "status:503",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true,
        "code": "server_error",
        "delay_max_ms": 500
      }
    },
    {
      "name": "post_503_no_retry",
      "input": {
        "method": "POST",
        "outcome": "status:503",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false,
        "code": "server_error"
      }
    },
    {
      "name": "get_timeout_after_send_retries",
      "input": {
        "method": "GET",
        "outcome": "timeout_after_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true,
        "code": "request_timeout"
      }
    },
    {
      "name": "put_timeout_after_send_retries",
      "input": {
        "method": "PUT",
        "outcome": "timeout_after_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true
      }
    },
    {
      "name": "post_timeout_after_send_no_retry",
      "input": {
        "method": "POST",
        "outcome": "timeout_after_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false,
        "code": "request_timeout"
      }
    },
    {
      "name": "patch_reset_after_send_no_retry",
      "input": {
        "method": "PATCH",
        "outcome": "connection_reset_after_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": false
      }
    },
    {
      "name": "delete_reset_after_send_retries",
      "input": {
        "method": "DELETE",
        "outcome": "connection_reset_after_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true
      }
    },
    {
      "name": "post_connect_failure_retries",
      "input": {
        "method": "POST",
        "outcome": "connect_failure",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true,
        "code": "network_unavailable"
      }
    },
    {
      "name": "post_dns_failure_retries",
      "input": {
        "method": "POST",
        "outcome": "dns_failure",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true
      }
    },
    {
      "name": "post_timeout_before_send_retries",
      "input": {
        "method": "POST",
        "outcome": "timeout_before_send",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true
      }
    },
    {
      "name": "post_429_retries",
      "input": {
        "method": "POST",
        "outcome": "status:429",
        "attempt": 0,
        "operation": "planner"
      },
      "expect": {
        "retry": true,
        "code": "rate_limited"
      }
    },
    {
      "name": "get_401_never",
      "input": {
        "method": "GET",
