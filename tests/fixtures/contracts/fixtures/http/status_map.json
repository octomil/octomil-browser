{
  "kind": "http_status",
  "description": "Status and transport outcome to canonical error code. 401/403 are never network errors.",
  "cases": [
    {
      "name": "status:400",
      "input": {
        "outcome": "status:400"
      },
      "expect": {
        "code": "invalid_input"
      }
    },
    {
